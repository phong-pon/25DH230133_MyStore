@model PagedList.IPagedList<_25DH230133_MyStore.Models.User>
@using PagedList.Mvc

@{
    ViewBag.Title = "Tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    string searchTerm = ViewBag.SearchTerm as string;
}

@using (Html.BeginForm("Index", "Users", FormMethod.Get, new { @class = "text-center", style = "margin-top:10px;" }))
{
    <input type="text" name="searchTerm" value="@searchTerm" class="form-control" style="display:inline-block;width:380px;" placeholder="Nhập tên đăng nhập hoặc vai trò (A/C)" />
    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
}

<h2 class="bg-success">DANH SÁCH TÀI KHOẢN</h2>
@if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<table class="table">
    <tr class="success"><th>Tên đăng nhập</th><th>Vai trò</th><th></th></tr>
    @foreach (var u in Model)
    {
        <tr class="info">
            <td>@u.Username</td>
            <td>@(u.UserRole.Trim() == "A" ? "A - Quản trị" : "C - Khách hàng")</td>
            <td>
                @Html.ActionLink("Sửa", "Edit", new { id = u.Username }, new { @class = "btn btn-primary btn-xs" })
                @Html.ActionLink("Xóa", "Delete", new { id = u.Username }, new { @class = "btn btn-primary btn-xs" })
            </td>
        </tr>
    }
</table>
<div class="pagination-container">
    @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchTerm }))
</div>
<p class="text-center">@Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })</p>

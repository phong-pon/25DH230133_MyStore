@model _25DH230133_MyStore.Models.User

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">XÓA TÀI KHOẢN</h2>
<h4 class="alert-danger">Bạn thực sự muốn xóa tài khoản này à?</h4>
<div class="bg-info" style="padding:10px 15px;">
    <dl>
        <dt>Tên đăng nhập</dt><dd>@Model.Username</dd>
        <dt>Vai trò</dt><dd>@Model.UserRole</dd>
    </dl>
</div>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <p style="margin-top:15px;">
        <input type="submit" value="Xóa" class="btn btn-primary" />
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary" })
    </p>
}

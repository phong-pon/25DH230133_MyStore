@model _25DH230133_MyStore.Models.Product

<div class="row">
    <div class="col-md-3 text-center">
        <img src="@Model.ImageUrl" style="max-width:100%;max-height:260px;" />
    </div>
    <div class="col-md-9 bg-info" style="padding:10px 15px;">
        <dl>
            <dt>Tên sản phẩm</dt>
            <dd>@Html.DisplayFor(model => model.ProductName)</dd>
            <dt>Mô tả</dt>
            <dd>@Html.DisplayFor(model => model.ProductDescription)</dd>
            <dt>Đơn giá</dt>
            <dd>@Html.DisplayFor(model => model.ProductPrice)</dd>
            <dt>Danh mục</dt>
            <dd>@Html.DisplayFor(model => model.Category.CategoryName)</dd>
        </dl>
    </div>
</div>

@model _25DH230133_MyStore.Models.ViewModel.HomeProductVM

<table class="table">
    <tr class="success">
        <th>Hình ảnh</th>
        <th>Tên sản phẩm</th>
        <th>Đơn giá</th>
        <th>Danh mục</th>
        <th></th>
    </tr>

    @foreach (var item in Model.NewProducts)
    {
        <tr class="info">
            <td><img src="@item.ImageUrl" style="max-width:85px;max-height:130px;" /></td>
            <td>@Html.DisplayFor(modelItem => item.ProductName)</td>
            <td>@Html.DisplayFor(modelItem => item.ProductPrice)</td>
            <td>@Html.DisplayFor(modelItem => item.Category.CategoryName)</td>
            <td>
                @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-primary btn-xs" })
                @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-primary btn-xs" })
                @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-primary btn-xs" })
            </td>
        </tr>
    }
</table>

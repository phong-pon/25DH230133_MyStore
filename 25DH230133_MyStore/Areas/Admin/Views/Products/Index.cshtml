@model _25DH230133_MyStore.Models.ViewModel.HomeProductVM
@using PagedList.Mvc

@{
    ViewBag.Title = "Sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@* Tìm kiếm theo tên / mô tả / danh mục và theo khoảng giá *@
@using (Html.BeginForm("Index", "Products", FormMethod.Get, new { @class = "text-center", style = "margin-top:10px;" }))
{
    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" style="display:inline-block;width:300px;" placeholder="Nhập tên, mô tả hoặc chủng loại sản phẩm" />
    <input type="text" name="minPrice" value="@Model.MinPrice" class="form-control" style="display:inline-block;width:180px;" placeholder="Nhập giá tối thiểu" />
    <input type="text" name="maxPrice" value="@Model.MaxPrice" class="form-control" style="display:inline-block;width:180px;" placeholder="Nhập giá tối đa" />
    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
}

<p class="text-center" style="margin-top:15px;">
    Sắp xếp theo:
    @Html.ActionLink("Tên tăng dần", "Index", new { searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = "name_asc" })|
    @Html.ActionLink("Tên giảm dần", "Index", new { searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = "name_desc" })|
    @Html.ActionLink("Giá tăng dần", "Index", new { searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = "price_asc" })|
    @Html.ActionLink("Giá giảm dần", "Index", new { searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = "price_desc" })
</p>

<h2 class="bg-success">DANH SÁCH SẢN PHẨM</h2>
@if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
@Html.Partial("PVListProduct", Model)

<div class="pagination-container">
    @Html.PagedListPager(Model.NewProducts, page => Url.Action("Index", new {
        page, searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder }))
</div>

<p class="text-center">
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
</p>

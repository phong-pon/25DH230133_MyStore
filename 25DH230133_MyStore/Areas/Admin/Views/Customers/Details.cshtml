@model _25DH230133_MyStore.Models.Customer

@{
    ViewBag.Title = "Chi tiết khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">CHI TIẾT KHÁCH HÀNG</h2>
<div class="bg-info" style="padding:10px 15px;">
    <dl>
        <dt>Họ tên</dt><dd>@Model.CustomerName</dd>
        <dt>Số điện thoại</dt><dd>@Model.CustomerPhone</dd>
        <dt>Email</dt><dd>@Model.CustomerEmail</dd>
        <dt>Địa chỉ</dt><dd>@Model.CustomerAddress</dd>
        <dt>Tài khoản</dt><dd>@Model.Username</dd>
    </dl>
</div>
<p style="margin-top:15px;">
    @Html.ActionLink("Đơn hàng", "Orders", new { id = Model.CustomerID }, new { @class = "btn btn-primary" })
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary" })
</p>

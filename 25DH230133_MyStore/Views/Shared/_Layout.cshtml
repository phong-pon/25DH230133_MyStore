@{
    //// lấy thông tin giỏ hàng
    //var cart = Session["Cart"] as _25DH230133_MyStore.Models.ViewModel.Cart;

    ////Tạo đối tượng ViewBag.pmmodel dạng PersonalMenuVM, và lưu trong ViewBag,
    ////khởi tạo giá trị dựa trên thông tin tài khoản đăng nhập
    //ViewBag.pmmodel = new _25DH230133_MyStore.Models.ViewModel.PersonalMenuVM
    //{
    //    IsLoggedIn = isAuthenticated ||
    //                     !string.IsNullOrWhiteSpace(sessionUsername),
    //    Username = User.Identity.IsAuthenticated ? User.Identity.Name : string.Empty
    //};
    ////nếu giỏ hàng không rỗng thì gán số lượng mặt hàng trong giỏ cho CartCount
    //if (cart != null && cart.Items.Any()) {
    //    ViewBag.pmmodel.CartCount = cart.Items.Count();

    // Lấy thông tin giỏ hàng
    var cart = Session["Cart"] as _25DH230133_MyStore.Models.ViewModel.Cart;

    // Kiểm tra trạng thái đăng nhập
    bool isAuthenticated = User.Identity.IsAuthenticated;

    // Lấy Username từ Session
    string sessionUsername = Session["Username"] as string;

    // Khởi tạo PersonalMenuVM
    ViewBag.pmmodel = new _25DH230133_MyStore.Models.ViewModel.PersonalMenuVM
    {
        IsLoggedIn = isAuthenticated ||
                     !string.IsNullOrWhiteSpace(sessionUsername),

        Username = isAuthenticated
            ? User.Identity.Name
            : sessionUsername ?? string.Empty
    };

    // Cập nhật số lượng sản phẩm trong giỏ hàng
    if (cart != null && cart.Items.Any())
    {
        ViewBag.pmmodel.CartCount = cart.Items.Count();
    }
}
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Store: @ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/css/bootstrap.min.css" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <style>
        /* Basic styling for the menu */

        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #f9f9f9;
            min-width: 160px;
            box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
            z-index: 1;
        }

            .dropdown-content a {
                color: black;
                padding: 12px 16px;
                text-decoration: none;
                display: block;
            }

                .dropdown-content a:hover {
                    background-color: #f1f1f1;
                }

        .dropdown:hover .dropdown-content {
            display: block;
        }
        /* Khung chứa logo và menu */
        .navbar.navbar-fixed-top > .container {
            position: relative !important;
            display: block !important;
            min-height: 62px;
        }

        /* Logo FASTOR bên trái */
        .navbar.navbar-fixed-top .navbar-header {
            position: absolute !important;
            left: 15px !important;
            top: 50% !important;
            transform: translateY(-50%);
            float: none !important;
            margin: 0 !important;
        }

        /* Menu bên phải */
        .navbar.navbar-fixed-top .navbar-collapse {
            position: absolute !important;
            right: 15px !important;
            top: 50% !important;
            transform: translateY(-50%);
            float: none !important;
            width: auto !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        /* Các mục menu nằm ngang */
        .navbar.navbar-fixed-top .navbar-nav {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            float: none !important;
            margin: 0 !important;
        }

            .navbar.navbar-fixed-top .navbar-nav > li {
                float: none !important;
                margin: 0 0 0 25px !important;
            }
    </style>
</head>
<body>
    <div class="navbar navbar-default navbar-fixed-top">
        <header class="container" style="background-color:lightgreen;">
            <h4 style="text-align:center; color:green;">Free ship đơn từ 40k, giảm nhiều hơn cùng
            <span style="font-weight:bolder; font-style:italic;"><span style="color:blue;">FREESHIP</span> XTRA</span></h4>
        </header>
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse" title="more options">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a href="@Url.Action("Index", "Home")" class="navbar-brand"><img src="~/Images/logo.PNG" style="max-height:30px;" /></a>
            </div>

            <div class="navbar-collapse collapse navbar-right">
                <ul class="nav navbar-nav">
                    <li>
                        <div style="position:relative;">
                            <i class="fas fa-home"></i>
                            @Html.ActionLink("Trang chủ", "Index", "Home")
                        </div>
                    </li>
                    <li class="dropdown">
                        <div style="position:relative;">
                            <i class="fas fa-user"></i>
                            <a href="javascript:void(0)" id="account-name">
                                @if (ViewBag.pmmodel.IsLoggedIn)
                                {
                                    <text>Hello,</text>@ViewBag.pmmodel.Username
                                }
                                else
                                {
                                    <text>Tài khoản</text>
                                }
                            </a>
                            <div class="dropdown-content">
                                @if (ViewBag.pmmodel.IsLoggedIn)
                                {
                                    <a href="@Url.Action("Profile", "Account")">Thông tin tài khoản</a>
                                    <a href="@Url.Action("OrderHistory", "Order")">Lịch sử mua hàng</a>
                                    <a href="@Url.Action("Logout", "Account")">Đăng xuất</a>
                                }
                                else
                                {
                                    <a href="@Url.Action("Register", "Account")">Đăng ký</a>
                                    <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
                                }
                            </div>
                        </div>
                    </li>
                    <li>
                        <div>
                            <a href="@Url.Action("Index2", "Cart")">
                                <i class="fas fa-shopping-cart"></i>
                                (<span id="cart-count">@ViewBag.pmmodel.CartCount</span>)
                            </a>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="body-content">
        @RenderBody()
    </div>

    <footer class="site-footer">
        <div class="pull-left footer-left">&copy; 2024 - Tên ứng dụng</div>
        <div class="pull-right text-right">
            <h4 class="footer-contact">Contact</h4>
            <p>Tên các thành viên trong nhóm</p>
        </div>
        <div class="clearfix"></div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/js/bootstrap.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>

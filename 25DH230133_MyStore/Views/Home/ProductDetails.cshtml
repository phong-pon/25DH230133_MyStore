@model _25DH230133_MyStore.Models.ViewModel.ProductDetailsVM

@{
    ViewBag.Title = "ProductDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <style>
        .pro {
            padding: 50px 10px 50px 10px;
            background-color: ghostwhite;
        }

        .pro-section {
            background-color: white;
            border: 1px groove #ffffff;
            border-radius: 10px;
            /*
            padding: 5px;*/
            margin: 10px;
        }

            .pro-section img {
                max-height: 250px;
                max-width: 200px;
                padding: 5px;
            }

        .pro-price {
            font-weight: bolder;
            font-size: larger;
            color: red;
        }

        .pro-sale {
            font-weight: lighter;
        }
    </style>
</head>
<div class="container-fluid pro">
    <div class="div-horizontal">
        @* Khối bên trái *@
        <div class="col-md-3 pro-section">
            @* Ảnh sản phẩm *@
            <img src="@Url.Content(Model.product.ProductImage)"
                 alt="@Model.product.ProductName"
                 style="width:100%; height:400px; object-fit:contain;"
                 onerror="this.style.display='none';" />
        </div>

        @* Khối ở giữa *@
        <div class="col-md-5 pro-section">
            @* Phần thông tin sản phẩm *@
            <div>
                <h4><strong>@Html.DisplayFor(model => model.product.ProductName)</strong></h4>
                <p class="pro-sale">Đã bán:&nbsp; @Model.product.OrderDetail.Count</p>
                <p class="pro-price">@Model.product.ProductPrice.ToString("C")</p>
                <p>Tủ sách:&nbsp; @Model.product.Category.CategoryName</p>
                <hr />

                <h5><strong>Mô tả</strong></h5>
                <p>@Model.product.ProductDescription</p>
            </div>
            <hr />

            @* Khối Related Product *@
            <div>@Html.Partial("_PVRelatedProduct", Model)</div>
        </div>

        @* Khối bên phải *@
        <div class="col-md-3 pro-section">
            <div class="form-group">
                @* Phần tạm tính *@
                @using (Html.BeginForm("ProductDetails", "Home", FormMethod.Get))
                {
                    <h4><strong>Số lượng</strong></h4>
                    <p>
                        <input type="number"
                               id="quantityInput"
                               name="quantity"
                               class="form-control"
                               value="@Model.quantity"
                               min="1"
                               step="1"
                               data-price="@Model.product.ProductPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                </p>

                <h4><strong>Tạm tính</strong></h4>
                <p>
                    <strong id="estimatedValue">
                        @Model.estimatedValue.ToString("N0") đ
                    </strong>
                </p>

                <p>
                    @Html.ActionLink("Thêm vào giỏ hàng", "AddToCart", "Cart",
                        new { id = Model.product.ProductID, quantity = Model.quantity },
                        new { @class = "btn btn-info" })
                </p>
            }
                <hr />
            </div>

            @* Khối TopProduct *@
            <div>@Html.Partial("_PVTopProduct", Model)</div>
        </div>
    </div>
</div>
@*tính tiền tự động phần tạm tính*@ 
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const quantityInput = document.getElementById("quantityInput");
        const estimatedValue = document.getElementById("estimatedValue");

        const price = parseFloat(quantityInput.dataset.price);

        function calculateTotal() {
            let quantity = parseInt(quantityInput.value) || 1;

            if (quantity < 1) {
                quantity = 1;
                quantityInput.value = 1;
            }

            const total = price * quantity;

            estimatedValue.textContent =
                new Intl.NumberFormat('vi-VN').format(total) + " đ";
        }

        quantityInput.addEventListener("input", calculateTotal);

        calculateTotal();
    });
</script>

